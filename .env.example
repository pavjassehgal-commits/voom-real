# Voom — environment variables (placeholders only, no real values)
# Copy this file to .env.local and fill in real values when the corresponding
# integration is wired up. Nothing here is connected yet.

# Site
NEXT_PUBLIC_SITE_URL=
# Used to authenticate the server-only job endpoints: Vercel Cron for the
# weekly planning job, and the Supabase-scheduled (5-minute) Instagram
# auto-publishing worker.
CRON_SECRET=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key — safe to expose in the browser (NEXT_PUBLIC_ prefix required).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key — server-only. Never prefix with NEXT_PUBLIC_ or it will be bundled into client code.
SUPABASE_SECRET_KEY=

# MARA AI (server-only — never add NEXT_PUBLIC_ to these names)
AI_PROVIDER=
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=

# MARA media generation (server-only; Gemini or OpenAI)
MEDIA_PROVIDER=
MEDIA_API_KEY=
MEDIA_BASE_URL=
MEDIA_IMAGE_MODEL=
MEDIA_VIDEO_MODEL=
# Used only for the confirmation estimate shown before video generation.
MEDIA_VIDEO_ESTIMATED_COST_PER_SECOND_USD=
MEDIA_MONTHLY_SPEND_LIMIT_USD=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Meta / Instagram
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=
META_INSTAGRAM_REDIRECT_URI=
# Active primary. Normal OAuth/token writes ALWAYS encrypt with this value.
INSTAGRAM_TOKEN_ENCRYPTION_KEY=
# Staged future primary. The protected rotation endpoint writes specifically to
# this key, and normal reads accept it before cutover. Leave EMPTY normally.
INSTAGRAM_TOKEN_ENCRYPTION_KEY_NEXT=
# Historical key(s), accepted for DECRYPTION ONLY. Comma-separated. This is not
# needed for the PRIMARY -> NEXT staged rotation because PRIMARY stays in place.
INSTAGRAM_TOKEN_ENCRYPTION_KEY_LEGACY=
# Dedicated one-off secret protecting the token re-encryption endpoint.
# Leave EMPTY to keep that endpoint disabled. Delete after the rotation.
INSTAGRAM_KEY_ROTATION_SECRET=

# Email (Resend server-only delivery)
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=
EMAIL_WEBHOOK_SECRET=

# SMS (ClickSend server-only delivery)
# HTTP Basic auth: CLICKSEND_USERNAME is the ClickSend account username and
# CLICKSEND_API_KEY is the API key used as the Basic auth password.
CLICKSEND_USERNAME=
CLICKSEND_API_KEY=
