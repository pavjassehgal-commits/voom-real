# Voom — environment variables (placeholders only, no real values)
# Copy this file to .env.local and fill in real values when the corresponding
# integration is wired up. Nothing here is connected yet.

# Site
NEXT_PUBLIC_SITE_URL=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key — safe to expose in the browser (NEXT_PUBLIC_ prefix required).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key — server-only. Never prefix with NEXT_PUBLIC_ or it will be bundled into client code.
SUPABASE_SECRET_KEY=

# MARA AI (server-only — never add NEXT_PUBLIC_ to these names)
AI_PROVIDER=
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Meta / Instagram
META_APP_ID=
META_APP_SECRET=

# Email
EMAIL_PROVIDER_API_KEY=

# SMS
SMS_PROVIDER_API_KEY=
