# Voom — environment variables (placeholders only, no real values)
# Copy this file to .env.local and fill in real values when the corresponding
# integration is wired up.

# Site
NEXT_PUBLIC_SITE_URL=
# Used to authenticate the server-only job endpoints: Vercel Cron for the
# weekly planning job, and Supabase-scheduled workers for Instagram publishing
# (5-minute cadence), durable media polling (2-minute cadence), the read-only
# Instagram performance collector (/api/cron/instagram-performance), the
# YouTube publish + reconcile workers (/api/cron/youtube-publish,
# /api/cron/youtube-reconcile) and the TikTok publish + reconcile workers
# (/api/cron/tiktok-publish, /api/cron/tiktok-reconcile).
CRON_SECRET=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key — safe to expose in the browser (NEXT_PUBLIC_ prefix required).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key — server-only. Never prefix with NEXT_PUBLIC_ or it will be bundled into client code.
SUPABASE_SECRET_KEY=

# MARA AI (server-only — never add NEXT_PUBLIC_ to these names)
AI_PROVIDER=
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=

# MARA image generation (server-only; OpenRouter Seedream 4.5 in production,
# Gemini/OpenAI remain available as alternate provider implementations).
# Never add NEXT_PUBLIC_ to these names — provider credentials stay server-side.
MEDIA_PROVIDER=
# OpenRouter image key (production). Used only when MEDIA_PROVIDER=openrouter.
OPENROUTER_API_KEY=
# Gemini/OpenAI image key. Used only when MEDIA_PROVIDER=gemini|openai.
MEDIA_API_KEY=
MEDIA_BASE_URL=
# Non-secret model id, e.g. bytedance-seed/seedream-4.5 for OpenRouter.
MEDIA_IMAGE_MODEL=
MEDIA_VIDEO_MODEL=
# Conservative internal estimates (USD) behind the AI media spend gate; the
# single source of truth is lib/mara/media-spend.ts. Replace them with real
# provider-reported costs when those are available.
MEDIA_IMAGE_ESTIMATED_COST_USD=
MEDIA_VIDEO_ESTIMATED_COST_PER_SECOND_USD=
MEDIA_MONTHLY_SPEND_LIMIT_USD=

# MARA video generation (server-only; set VIDEO_PROVIDER=openrouter for V1 production).
# OpenRouter reuses OPENROUTER_API_KEY above; do not create a second video key.
# VIDEO_API_KEY remains supported for the existing Magic Hour fallback.
# Never add NEXT_PUBLIC_ to these names — provider credentials stay server-side.
VIDEO_PROVIDER=
VIDEO_API_KEY=
VIDEO_BASE_URL=
VIDEO_MODEL=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Meta / Instagram
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=
META_INSTAGRAM_REDIRECT_URI=
# Active primary. Normal OAuth/token writes ALWAYS encrypt with this value.
INSTAGRAM_TOKEN_ENCRYPTION_KEY=
# Staged future primary. The protected rotation endpoint writes specifically to
# this key, and normal reads accept it before cutover. Leave EMPTY normally.
INSTAGRAM_TOKEN_ENCRYPTION_KEY_NEXT=
# Historical key(s), accepted for DECRYPTION ONLY. Comma-separated. This is not
# needed for the PRIMARY -> NEXT staged rotation because PRIMARY stays in place.
INSTAGRAM_TOKEN_ENCRYPTION_KEY_LEGACY=
# Dedicated one-off secret protecting the token re-encryption endpoint.
# Leave EMPTY to keep that endpoint disabled. Delete after the rotation.
INSTAGRAM_KEY_ROTATION_SECRET=

# Google / YouTube (server-only; YouTube Provider Integration, migration 0047)
# OAuth client from Google Cloud Console (GCP), with the exact registered
# redirect URI below. Never add NEXT_PUBLIC_ to these names.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=
# Active primary. Normal OAuth/token writes ALWAYS encrypt with this value.
YOUTUBE_TOKEN_ENCRYPTION_KEY=
# Staged future primary. Leave EMPTY normally.
YOUTUBE_TOKEN_ENCRYPTION_KEY_NEXT=
# Historical key(s), accepted for DECRYPTION ONLY. Comma-separated.
YOUTUBE_TOKEN_ENCRYPTION_KEY_LEGACY=
# Truthful UI wording only: set true ONLY after the GCP project has passed
# the YouTube API Services Compliance Audit. Default false (restricted).
# Provider truth always wins over this flag.
YOUTUBE_PROJECT_AUDITED=

# TikTok for Developers (server-only; TikTok Provider Integration, migration 0049)
# Client key/secret from the TikTok for Developers portal, with the Content
# Posting API product enabled and the EXACT redirect URI below registered on
# the app's Login Kit configuration. Never add NEXT_PUBLIC_ to these names.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=
# Active primary. Normal OAuth/token writes ALWAYS encrypt with this value.
TIKTOK_TOKEN_ENCRYPTION_KEY=
# Staged future primary. Leave EMPTY normally.
TIKTOK_TOKEN_ENCRYPTION_KEY_NEXT=
# Historical key(s), accepted for DECRYPTION ONLY. Comma-separated.
TIKTOK_TOKEN_ENCRYPTION_KEY_LEGACY=
# Truthful UI wording only: set true ONLY after Voom's TikTok app has passed
# TikTok's content-sharing audit. Default false (posts restricted to SELF_ONLY
# viewership, 5 posting users per 24h per TikTok's Content Sharing Guidelines).
# The live provider response always wins over this flag.
TIKTOK_APP_AUDITED=

# Email (Resend server-only delivery)
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=
EMAIL_WEBHOOK_SECRET=

# SMS marketing was removed from Voom. No SMS provider is configured; the
# historical ClickSend variables are intentionally not listed here.

# --- Development/test-only controls -----------------------------------------
# Shows the temporary "Preview 7-Day Plan (No Media)" control on the Marketing
# Plan screen. Leave unset in production: the control is hidden by default.
NEXT_PUBLIC_ENABLE_PLANNING_PREVIEW=

# Signs the per-recipient unsubscribe tokens in every marketing email.
# Required: this is the ONLY credential accepted for unsubscribe signing and
# verification — there is deliberately NO fallback to SUPABASE_SECRET_KEY or
# any other secret. Without it, the branded engine refuses to send rather
# than email a link that would not work.
EMAIL_UNSUBSCRIBE_SECRET=generate-a-long-random-string
